@page "/condiciones"
<PageTitle>Condiciones</PageTitle>

<h3>Condiciones</h3>
<div class="mb-3 row">
    <div class="col-sm-10">
        Edad: <input type="number" class="form-control" id="txtNonbre" @bind="_edad" />
    </div>
</div>

<div class="row mb-3">
    <div class="col">
        <button class="btn btn-primary" @onclick="verificaredad">Verificar</button>
    </div>
</div>


